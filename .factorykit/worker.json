{
  "repository": "SuguruSasaki/factorykit",
  "base": "main",
  "model": "sonnet",
  "review_model": "sonnet",
  "protected_paths": [
    ".agents/skills/rust-coding",
    ".agents/skills/markdown-docs",
    "docs/decisions"
  ],
  "formatters": [
    {
      "name": "rustfmt",
      "argv": ["cargo", "fmt", "--all"],
      "paths": ["*.rs", "**/*.rs"],
      "timeout_seconds": 300
    }
  ],
  "checks": [
    {
      "name": "Markdown patch whitespace",
      "argv": ["git", "diff", "--cached", "--check"],
      "paths": ["*.md", "**/*.md"],
      "timeout_seconds": 60
    },
    {
      "name": "Rust static checks and tests",
      "argv": ["./.agents/validate", "rust"],
      "paths": [
        "src/**",
        "tests/**",
        "Cargo.toml",
        "Cargo.lock",
        "skills/factorykit/**"
      ],
      "timeout_seconds": 1800
    }
  ]
}
